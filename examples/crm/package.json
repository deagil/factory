{
  "name": "@workspace/example-crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/system.ts"
  },
  "scripts": {
    "dev": "drizzle-kit push --force && FACTORY_DEV=1 node --watch src/main.ts",
    "start": "node src/main.ts",
    "db:studio": "drizzle-kit studio --config drizzle.studio.config.ts",
    "db:lint-migrations": "node node_modules/@workspace/db/src/bin/lint-migrations.ts migrations",
    "db:check-migrations": "node node_modules/@workspace/db/src/bin/check-migrations.ts .",
    "config:validate": "node node_modules/@workspace/server/src/bin/validate-config.ts .",
    "typecheck": "tsc --noEmit",
    "lint": "ultracite check",
    "test": "vitest run"
  },
  "dependencies": {
    "@workspace/actions": "workspace:*",
    "@workspace/config": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/objects": "workspace:*",
    "@workspace/server": "workspace:*",
    "@workspace/workflows": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@workspace/auth": "workspace:*",
    "@workspace/events": "workspace:*",
    "@workspace/testing": "workspace:*",
    "drizzle-kit": "^0.31.11"
  },
  "factory": {
    "system": "./src/system.ts"
  }
}
