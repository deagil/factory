# Copy to .env and fill in. Never commit real values.

# The app's database. `fx start` points each change's worktree at its own.
DATABASE_URL=postgres://postgres@localhost:5432/factory
# A role that can create and drop databases, used by `fx` and the tests.
# It connects to the `postgres` maintenance database, never to app data.
DATABASE_ADMIN_URL=postgres://postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
