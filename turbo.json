{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "//#lint:root": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_ADMIN_URL"]
    },
    "@workspace/actions#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_ADMIN_URL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/**/*.{ts,tsx}",
        "$TURBO_ROOT$/modules/**/*.{ts,tsx}",
        "$TURBO_ROOT$/examples/**/*.{ts,tsx}",
        "$TURBO_ROOT$/templates/**/*.{ts,tsx}",
        "$TURBO_ROOT$/examples/*/config/**",
        "$TURBO_ROOT$/packages/db/migrations/**"
      ]
    },
    "@workspace/fx#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_ADMIN_URL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/**/*.{ts,tsx}",
        "$TURBO_ROOT$/modules/**/*.{ts,tsx}",
        "$TURBO_ROOT$/examples/**/*.{ts,tsx}",
        "$TURBO_ROOT$/templates/**/*.{ts,tsx}",
        "$TURBO_ROOT$/examples/*/config/**",
        "$TURBO_ROOT$/packages/db/migrations/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL"]
    }
  },
  "globalDependencies": [
    "tsconfig.base.json",
    "oxlint.config.ts",
    "oxfmt.config.ts"
  ]
}
