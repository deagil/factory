{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "//#lint:root": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_ADMIN_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    "tsconfig.base.json",
    "oxlint.config.ts",
    "oxfmt.config.ts"
  ]
}
