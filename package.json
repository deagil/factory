{
  "name": "factory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm db:migrate && turbo run dev db:studio",
    "lint": "turbo lint lint:root",
    "format": "ultracite fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint:root": "ultracite check docs examples templates .github *.md *.json *.yaml *.yml *.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "db:lint-migrations": "pnpm --filter @workspace/db db:lint-migrations",
    "db:check-migrations": "pnpm --filter @workspace/db db:check-migrations",
    "db:studio": "pnpm --filter @workspace/example-crm db:studio",
    "fx": "node tools/fx/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0"
}
