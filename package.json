    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^24",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.91.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.2",
    "ultracite": "8.1.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
